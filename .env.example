# Environment configuration
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=change-this-in-production-to-a-very-secure-random-key

# Database
# For local development: sqlite:///catalogue.db
# For Supabase / Render PostgreSQL: postgresql://postgres:password@db.xxx.supabase.co:5432/postgres
DATABASE_URL=sqlite:///catalogue.db

# Cloudinary (Optional - for persistent external image uploads on cloud hosts)
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret

# Default Admin Seed (Optional - will be created if not exists)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@catalogue.com
ADMIN_PASSWORD=AdminSecure2026!

# Resend Email Configuration (https://resend.com)
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM_EMAIL=onboarding@resend.dev
ADMIN_NOTIFICATION_EMAIL=admin@catalogue.com
